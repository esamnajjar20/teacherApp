import 'package:flutter/material.dart';
import 'package:teacher_app/core/utils/color_utils.dart';

import '../../../../core/constants/app_constants.dart';
import '../../../../core/errors/error_message.dart';
import '../../../../shared/models/attendance_model.dart';
import '../../../../shared/models/class_model.dart';
import '../../../../shared/models/student_model.dart';
import '../../../../shared/services/database_service.dart';

class TakeAttendanceScreen extends StatefulWidget {
  final ClassModel classModel;
  final List<StudentModel> students;

  /// تاريخ الجلسة عند فتح الشاشة (لتعديل جلسة سابقة). الافتراضي: اليوم.
  final DateTime? initialDate;

  const TakeAttendanceScreen({
    super.key,
    required this.classModel,
    required this.students,
    this.initialDate,
  });

  @override
  State<TakeAttendanceScreen> createState() => _TakeAttendanceScreenState();
}

class _TakeAttendanceScreenState extends State<TakeAttendanceScreen> {
  final _db = DatabaseService();
  late Map<String, String> _statusMap; // studentId -> status
  late DateTime _selectedDate;
  bool _isSaving = false;
  bool _isLoadingExisting = false;

  /// هل هناك تعديلات لم تُحفظ بعد؟
  bool _dirty = false;

  /// نص البحث في قائمة الطلاب
  final _searchCtrl = TextEditingController();
  String _search = '';

  /// الطلاب الغائبون في آخر جلسة (للإشارة)
  Set<String> _absentLastSession = {};

  @override
  void initState() {
    super.initState();
    final base = widget.initialDate ?? DateTime.now();
    _selectedDate = DateTime(base.year, base.month, base.day);
    _resetToDefault();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (mounted) _loadExisting();
    });
  }

  /// الافتراضي = حاضر لكل الطلاب
  void _resetToDefault() {
    _statusMap = {
      for (final s in widget.students) s.id: AppConstants.present,
    };
  }

  /// إذا كان الحضور مسجلاً مسبقاً لهذا اليوم نعرضه للتعديل
  /// بدل البدء من الصفر (وبدل فشل الحفظ بسبب تكرار الجلسة).
  Future<void> _loadExisting() async {
    if (widget.students.isEmpty) return;
    final date = _selectedDate;
    setState(() => _isLoadingExisting = true);
    try {
      final session = await _db.findSession(
        classId: widget.classModel.id,
        date: date,
      );
      final records = session == null
          ? const <AttendanceRecordModel>[]
          : await _db.getRecordsForSession(session.id);

      // المستخدم غيّر التاريخ أثناء التحميل → تجاهل النتيجة القديمة
      if (!mounted || date != _selectedDate) return;

      setState(() {
        _resetToDefault();
        for (final r in records) {
          if (_statusMap.containsKey(r.studentId)) {
            _statusMap[r.studentId] = r.status;
          }
        }
        _dirty = false;
      });
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(friendlyError(e)), backgroundColor: Colors.red),
      );
    } finally {
      if (mounted && date == _selectedDate) {
        setState(() => _isLoadingExisting = false);
      }
    }
  }

  Color _statusColor(String status) {
    switch (status) {
      case AppConstants.present:
        return Colors.green;
      case AppConstants.absent:
        return Colors.red;
      case AppConstants.late:
        return Colors.orange;
      case AppConstants.excused:
        return Colors.blue;
      default:
        return Colors.grey;
    }
  }

  IconData _statusIcon(String status) {
    switch (status) {
      case AppConstants.present:
        return Icons.check_circle;
      case AppConstants.absent:
        return Icons.cancel;
      case AppConstants.late:
        return Icons.access_time;
      case AppConstants.excused:
        return Icons.info;
      default:
        return Icons.help;
    }
  }

  static const _order = [
    AppConstants.present,
    AppConstants.absent,
    AppConstants.late,
    AppConstants.excused,
  ];

  void _cycleStatus(String studentId) {
    final current = _statusMap[studentId] ?? AppConstants.present;
    final nextIndex = (_order.indexOf(current) + 1) % _order.length;
    setState(() {
      _statusMap[studentId] = _order[nextIndex];
      _dirty = true;
    });
  }

  /// اختيار حالة محددة بالضغط المطوّل
  Future<void> _pickStatus(StudentModel student) async {
    final picked = await showModalBottomSheet<String>(
      context: context,
      builder: (ctx) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Padding(
              padding: const EdgeInsets.all(16),
              child: Text(student.fullName,
                  style: const TextStyle(fontWeight: FontWeight.bold)),
            ),
            for (final st in _order)
              ListTile(
                leading: Icon(_statusIcon(st), color: _statusColor(st)),
                title: Text(AppConstants.attendanceStatusLabels[st] ?? st),
                onTap: () => Navigator.pop(ctx, st),
              ),
          ],
        ),
      ),
    );
    if (picked == null || !mounted) return;
    setState(() {
      _statusMap[student.id] = picked;
      _dirty = true;
    });
  }

  void _setAll(String status) {
    setState(() {
      for (final id in _statusMap.keys) {
        _statusMap[id] = status;
      }
      _dirty = true;
    });
  }

  Future<bool> _confirmDiscard() async {
    final leave = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('تعديلات غير محفوظة'),
        content: const Text('لم تحفظ الحضور بعد. هل تريد الخروج وتجاهل التعديلات؟'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx, false),
            child: const Text('البقاء'),
          ),
          TextButton(
            onPressed: () => Navigator.pop(ctx, true),
            child: const Text('خروج دون حفظ', style: TextStyle(color: Colors.red)),
          ),
        ],
      ),
    );
    return leave == true;
  }

  Future<void> _save() async {
    if (_isLoadingExisting) return;
    if (widget.students.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('لا يوجد طلاب في الفصل')),
      );
      return;
    }

    // منع تسجيل حضور لتاريخ مستقبلي
    final today = DateTime.now();
    final selected = DateTime(_selectedDate.year, _selectedDate.month, _selectedDate.day);
    final now = DateTime(today.year, today.month, today.day);
    if (selected.isAfter(now)) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('لا يمكن تسجيل حضور لتاريخ مستقبلي'),
          backgroundColor: Colors.red,
        ),
      );
      return;
    }

    setState(() => _isSaving = true);

    try {
      final session = await _db.getOrCreateSession(
        classId: widget.classModel.id,
        date: _selectedDate,
      );

      await _db.saveAttendanceRecords(
        sessionId: session.id,
        records: _statusMap.entries
            .map((e) => (studentId: e.key, status: e.value))
            .toList(),
      );

      if (mounted) {
        _dirty = false;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('تم حفظ الحضور بنجاح'),
            backgroundColor: Colors.green,
          ),
        );
        Navigator.pop(context, true);
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text(friendlyError(e)), backgroundColor: Colors.red),
        );
      }
    } finally {
      if (mounted) setState(() => _isSaving = false);
    }
  }

  @override
  void dispose() {
    _searchCtrl.dispose();
    super.dispose();
  }

  /// نسخ حضور آخر جلسة على هذا التاريخ
  Future<void> _copyLastSession() async {
    try {
      final sessions = await _db.getSessionsForClass(widget.classModel.id);
      // استبعاد الجلسة الحالية (إن وُجدت)
      final currentSession = await _db.findSession(
        classId: widget.classModel.id,
        date: _selectedDate,
      );
      final previous = sessions.where((s) => s.id != currentSession?.id).toList();

      if (previous.isEmpty) {
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('لا توجد جلسة سابقة لنسخها'),
            backgroundColor: Colors.orange,
          ),
        );
        return;
      }

      final lastSession = previous.first;
      final records = await _db.getRecordsForSession(lastSession.id);

      if (!mounted) return;
      final confirmed = await showDialog<bool>(
        context: context,
        builder: (ctx) => AlertDialog(
          title: const Text('نسخ من آخر جلسة'),
          content: Text(
            'سيُنسخ حضور جلسة ${lastSession.date.year}/'
            '${lastSession.date.month.toString().padLeft(2, '0')}/'
            '${lastSession.date.day.toString().padLeft(2, '0')} '
            '(${records.length} سجل).

'
            'ستُستبدل الحالات الحالية. هل تريد المتابعة؟',
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(ctx, false),
              child: const Text('إلغاء'),
            ),
            ElevatedButton(
              onPressed: () => Navigator.pop(ctx, true),
              child: const Text('نسخ'),
            ),
          ],
        ),
      );

      if (confirmed != true || !mounted) return;

      setState(() {
        _resetToDefault();
        for (final r in records) {
          if (_statusMap.containsKey(r.studentId)) {
            _statusMap[r.studentId] = r.status;
          }
        }
        _dirty = true;
      });

      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('تم نسخ الحضور — راجع ثم اضغط حفظ'),
          backgroundColor: Colors.blue,
        ),
      );
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(friendlyError(e)), backgroundColor: Colors.red),
      );
    }
  }

  /// تحميل الغائبين من آخر جلسة (لإظهار شارة بجانب الطالب)
  Future<void> _loadAbsentLastSession() async {
    try {
      final sessions = await _db.getSessionsForClass(widget.classModel.id);
      if (sessions.isEmpty) return;

      final currentSession = await _db.findSession(
        classId: widget.classModel.id,
        date: _selectedDate,
      );
      final previous = sessions.where((s) => s.id != currentSession?.id).toList();
      if (previous.isEmpty) return;

      final records = await _db.getRecordsForSession(previous.first.id);
      if (!mounted) return;
      setState(() {
        _absentLastSession = records
            .where((r) => r.status == AppConstants.absent)
            .map((r) => r.studentId)
            .toSet();
      });
    } catch (_) {}
  }

  Future<void> _pickDate() async {
    final picked = await showDatePicker(
      context: context,
      initialDate: _selectedDate,
      firstDate: DateTime(2020),
      lastDate: DateTime.now(),
      locale: const Locale('ar'),
    );
    if (picked == null) return;
    if (_dirty && !await _confirmDiscard()) return;
    if (!mounted) return;
    setState(() {
      _selectedDate = DateTime(picked.year, picked.month, picked.day);
      _dirty = false;
    });
    _loadExisting();
  }

  @override
  Widget build(BuildContext context) {
    final presentCount =
        _statusMap.values.where((s) => s == AppConstants.present).length;
    final absentCount =
        _statusMap.values.where((s) => s == AppConstants.absent).length;
    final lateCount =
        _statusMap.values.where((s) => s == AppConstants.late).length;
    final excusedCount =
        _statusMap.values.where((s) => s == AppConstants.excused).length;

    return PopScope(
      canPop: !_dirty,
      onPopInvokedWithResult: (didPop, result) async {
        if (didPop) return;
        if (await _confirmDiscard() && mounted) {
          setState(() => _dirty = false);
          Navigator.pop(context);
        }
      },
      child: Scaffold(
        appBar: AppBar(
          title: const Text('تسجيل الحضور'),
          actions: [
            PopupMenuButton<String>(
              icon: const Icon(Icons.more_vert, color: Colors.white),
              onSelected: (value) {
                if (value == 'copy') _copyLastSession();
              },
              itemBuilder: (_) => const [
                PopupMenuItem(
                  value: 'copy',
                  child: Row(
                    children: [
                      Icon(Icons.copy_all_outlined, size: 20),
                      SizedBox(width: 8),
                      Text('نسخ من آخر جلسة'),
                    ],
                  ),
                ),
              ],
            ),
            TextButton(
              onPressed: (_isSaving || _isLoadingExisting) ? null : _save,
              child: _isSaving
                  ? const SizedBox(
                      width: 20,
                      height: 20,
                      child: CircularProgressIndicator(strokeWidth: 2, color: Colors.white),
                    )
                  : const Text('حفظ', style: TextStyle(color: Colors.white)),
            ),
          ],
        ),
        body: Column(
          children: [
            // شريط التاريخ + الملخص
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(16),
              color: Theme.of(context).primaryColor.soft(0.08),
              child: Column(
                children: [
                  InkWell(
                    onTap: _pickDate,
                    child: Row(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        const Icon(Icons.calendar_today, size: 18),
                        const SizedBox(width: 8),
                        Text(
                          '${_selectedDate.year}/${_selectedDate.month.toString().padLeft(2, '0')}/${_selectedDate.day.toString().padLeft(2, '0')}',
                          style: const TextStyle(
                            fontWeight: FontWeight.bold,
                            fontSize: 16,
                          ),
                        ),
                        const SizedBox(width: 4),
                        const Icon(Icons.edit, size: 16),
                      ],
                    ),
                  ),
                  const SizedBox(height: 12),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                    children: [
                      _SummaryChip(label: 'حاضر', count: presentCount, color: Colors.green),
                      _SummaryChip(label: 'غائب', count: absentCount, color: Colors.red),
                      _SummaryChip(label: 'متأخر', count: lateCount, color: Colors.orange),
                      _SummaryChip(label: 'بعذر', count: excusedCount, color: Colors.blue),
                    ],
                  ),
                  const SizedBox(height: 8),
                  Wrap(
                    alignment: WrapAlignment.center,
                    spacing: 8,
                    children: [
                      TextButton.icon(
                        onPressed: widget.students.isEmpty
                            ? null
                            : () => _setAll(AppConstants.present),
                        icon: const Icon(Icons.check_circle_outline,
                            color: Colors.green, size: 18),
                        label: const Text('الكل حاضر'),
                      ),
                      TextButton.icon(
                        onPressed: widget.students.isEmpty
                            ? null
                            : () => _setAll(AppConstants.absent),
                        icon: const Icon(Icons.cancel_outlined,
                            color: Colors.red, size: 18),
                        label: const Text('الكل غائب'),
                      ),
                      TextButton.icon(
                        onPressed: widget.students.isEmpty
                            ? null
                            : () => _setAll(AppConstants.late),
                        icon: const Icon(Icons.access_time,
                            color: Colors.orange, size: 18),
                        label: const Text('الكل متأخر'),
                      ),
                    ],
                  ),
                ],
              ),
            ),
            if (_isLoadingExisting) const LinearProgressIndicator(minHeight: 2),
            // حقل البحث
            if (widget.students.length > 5)
              Padding(
                padding: const EdgeInsets.fromLTRB(16, 8, 16, 0),
                child: TextField(
                  controller: _searchCtrl,
                  decoration: InputDecoration(
                    isDense: true,
                    hintText: 'ابحث باسم الطالب...',
                    prefixIcon: const Icon(Icons.search, size: 20),
                    suffixIcon: _search.isEmpty
                        ? null
                        : IconButton(
                            icon: const Icon(Icons.clear, size: 20),
                            onPressed: () {
                              _searchCtrl.clear();
                              setState(() => _search = '');
                            },
                          ),
                  ),
                  onChanged: (v) => setState(() => _search = v.trim()),
                ),
              ),
            // قائمة الطلاب
            Expanded(
              child: widget.students.isEmpty
                  ? const Center(child: Text('لا يوجد طلاب في الفصل'))
                  : Builder(
                      builder: (context) {
                        final filtered = _search.isEmpty
                            ? widget.students
                            : widget.students
                                .where((s) => s.fullName
                                    .toLowerCase()
                                    .contains(_search.toLowerCase()))
                                .toList();
                        if (filtered.isEmpty) {
                          return const Center(
                              child: Text('لا توجد نتائج مطابقة'));
                        }
                        return ListView.builder(
                      itemCount: filtered.length,
                      itemBuilder: (context, index) {
                        final student = filtered[index];
                        final status = _statusMap[student.id] ?? AppConstants.present;
                        final wasAbsent = _absentLastSession.contains(student.id);
                        return ListTile(
                          leading: CircleAvatar(
                            backgroundColor: _statusColor(status).soft(0.15),
                            child: Icon(
                              _statusIcon(status),
                              color: _statusColor(status),
                            ),
                          ),
                          title: Text(
                            student.fullName,
                            style: const TextStyle(fontWeight: FontWeight.w600),
                          ),
                          subtitle: Text(
                            AppConstants.attendanceStatusLabels[status] ?? status,
                            style: TextStyle(color: _statusColor(status)),
                          ),
                          trailing: Row(
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              if (wasAbsent)
                                Container(
                                  margin: const EdgeInsets.only(left: 4),
                                  padding: const EdgeInsets.symmetric(
                                      horizontal: 6, vertical: 2),
                                  decoration: BoxDecoration(
                                    color: Colors.red.shade50,
                                    borderRadius: BorderRadius.circular(8),
                                  ),
                                  child: const Text(
                                    'غاب سابقاً',
                                    style: TextStyle(
                                        fontSize: 10, color: Colors.red),
                                  ),
                                ),
                              Icon(
                                Icons.touch_app,
                                color: Colors.grey[400],
                              ),
                            ],
                          ),
                          onTap: () => _cycleStatus(student.id),
                          onLongPress: () => _pickStatus(student),
                        );
                      },
                    );
                      },
                    ),
            ),
            // تلميح
            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(12),
              color: Colors.grey[100],
              child: Text(
                'اضغط لتغيير الحالة (حاضر ← غائب ← متأخر ← بعذر)، أو اضغط مطوّلاً لاختيارها مباشرة',
                textAlign: TextAlign.center,
                style: TextStyle(fontSize: 12, color: Colors.grey[600]),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _SummaryChip extends StatelessWidget {
  final String label;
  final int count;
  final Color color;

  const _SummaryChip({
    required this.label,
    required this.count,
    required this.color,
  });

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Text(
          '$count',
          style: TextStyle(
            fontWeight: FontWeight.bold,
            fontSize: 18,
            color: color,
          ),
        ),
        Text(label, style: TextStyle(fontSize: 12, color: Colors.grey[700])),
      ],
    );
  }
}
